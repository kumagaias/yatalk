{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist-server",
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "types": ["node"],
    "sourceMap": false,
    "declaration": false
  },
  "include": ["server/**/*.ts", "shared/**/*.ts"],
  "exclude": ["tests", "node_modules", "dist", "dist-server"]
}
